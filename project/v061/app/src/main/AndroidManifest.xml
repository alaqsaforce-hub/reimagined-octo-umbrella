<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dictation: microphone is used only while a dictation session is active (visible indicator + notification). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Floating assistant over other apps; requested through a user-initiated setup step. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v0.6: mic-FREE floating assistant. Android 14+ uses specialUse, Android 10-13 dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- v1.0.0 wake word: one short buzz when "শাহরুখ" is heard. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.0.0: only offered when the user turns on "listen with the screen off" — Android otherwise
         stops the microphone foreground service within minutes. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Online speech recognition (Google / device recogniser) and later AI providers. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- v1.2.0 reminders. SCHEDULE_EXACT_ALARM is a *special access* on Android 12+ (the user grants it in
         system settings); without it the same alarm still fires through setAndAllowWhileIdle, a few minutes
         late — the app says so in Settings instead of silently missing the time. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v1.2.0: pending reminders are re-armed after a reboot (install-time permission, no dialog). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- v0.9.0 calls: placing, answering/declining and resolving a contact name to a number.
         All four are runtime permissions requested from Settings -> Commands, never automatically. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- v1.3.0 device access: which SIM the phone has, its (masked) own number, and whether a call can be
         aimed at a specific SIM. READ_PHONE_NUMBERS is the only new runtime prompt; READ_BASIC_PHONE_STATE is
         install-time on API 33+ and lets the app ask "is telephony there at all" without the sensitive one. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <!-- v1.3.0 Termux: running a shell command (and through it proot-Ubuntu / OpenCode) is possible only via
         Termux's own RUN_COMMAND service. This is a signature-less custom permission Termux defines; Termux
         must ALSO have "allow-external-apps=true" in ~/.termux/termux.properties, which the app can only
         explain, never set. Without either side the command is honestly reported as not run. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- VoiceDock works on tablets/Chromebooks without telephony: the call commands simply report that
         no phone app can place a call there. required="false" keeps the app installable. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Android 11+ package visibility: needed to find the device's speech recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Agent "open app": find launchable apps by name (only launcher entries, not all packages). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Browser sign-in (ChatGPT / OpenRouter). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- v1.3.0 — Termux (and nothing else) is named explicitly: the RUN_COMMAND service and its label are
             looked up by package, and package visibility would otherwise hide it on Android 11+. -->
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".VoiceDockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.VoiceDock">

        <!-- v1.0.0 — hotword listener. A microphone foreground service: Android shows its notification
             for as long as the microphone is open, and it is started only by a user action in the app. -->
        <service
            android:name=".hotword.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.10.0 — digital assistant (ROLE_ASSISTANT): long-press home / the assist gesture opens
                 VoiceDock, which starts the bubble and asks for the microphone. Declaring ASSIST is what
                 makes VoiceDock appear in Settings → Default apps → Digital assistant. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Back to app" link on the sign-in finished page (voicedock://auth). Carries no data. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voicedock" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- Share → VoiceDock and the text-selection menu ("Save to VoiceDock"). Nothing is stored until the user taps Save. -->
        <activity
            android:name=".ui.CaptureActivity"
            android:exported="true"
            android:label="@string/capture_label"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- v0.6 mic-FREE contextual assistant bubble + card/chat windows. No RECORD_AUDIO needed. -->
        <service
            android:name=".overlay.AssistantOverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-initiated floating assistant bubble; reads visible screen text only when the user taps the bubble; no background screen monitoring." />
        </service>

        <!-- Declared but a NO-OP until the user grants notification access AND enables it in Settings. -->
        <service
            android:name=".events.VoiceDockNotificationListener"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Floating bubble + panel; holds the microphone foreground-service while dictating. -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Optional, explicitly enabled: inserts text into the focused text field when the user taps Insert. -->
        <service
            android:name=".insertion.InsertAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_insert" />
        </service>

        <!-- v1.2.0 — a reminder's alarm. Not exported: only our own PendingIntent can fire it. -->
        <receiver
            android:name=".schedule.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.voicedock.ai.reminder.FIRE" />
            </intent-filter>
        </receiver>
        <!-- v1.2.0 — re-arm pending reminders after a reboot (alarms do not survive it). -->
        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
            <!-- VoiceDock keyboard (phonetic Bengali / English + voice strip). The user enables it in system settings. -->
        <service
            android:name=".ime.VoiceDockIme"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
